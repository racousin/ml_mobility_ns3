cmake_minimum_required(VERSION 3.10 FATAL_ERROR)
project({{ project_name }})

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED TRUE)

# Find PyTorch
find_package(Torch REQUIRED)
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${TORCH_CXX_FLAGS}")

# Include directories
include_directories(.)

# Create library for NS-3 integration
add_library(netmob25_mobility_lib STATIC
    trajectory_generator.cc
)

# Link libraries to the library
target_link_libraries(netmob25_mobility_lib "${TORCH_LIBRARIES}")

# Set C++ standard for target
set_property(TARGET netmob25_mobility_lib PROPERTY CXX_STANDARD 17)

# Enable debugging symbols
set(CMAKE_BUILD_TYPE Debug)

# Print some useful information
message(STATUS "Torch version: ${Torch_VERSION}")
message(STATUS "Torch libraries: ${TORCH_LIBRARIES}")
message(STATUS "Project: {{ experiment_name }}")