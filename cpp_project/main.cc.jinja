#include "trajectory_generator.h"
#include <iostream>
#include <torch/torch.h>
#include <torch/script.h>

int main() {
    try {
        std::cout << "=== {{ experiment_name }} Trajectory Generator ===" << std::endl;
        std::cout << "Loading model from: {{ model_path }}" << std::endl;
        
        // Initialize generator
        TrajectoryGenerator generator("{{ model_path }}");
        
        // Test generation
        std::cout << "\nGenerating test trajectories..." << std::endl;
        
        // Generate a batch of trajectories
        int batch_size = 5;
        int sequence_length = 100;
        
        auto trajectories = generator.generate(batch_size, sequence_length);
        
        std::cout << "Generated " << trajectories.size(0) << " trajectories" << std::endl;
        std::cout << "Trajectory shape: [" << trajectories.size(0) << ", " 
                  << trajectories.size(1) << ", " << trajectories.size(2) << "]" << std::endl;
        
        // Print first trajectory sample
        if (trajectories.size(0) > 0) {
            std::cout << "\nFirst trajectory (first 5 points):" << std::endl;
            for (int i = 0; i < std::min(5L, trajectories.size(1)); i++) {
                std::cout << "  Point " << i << ": [";
                for (int j = 0; j < trajectories.size(2); j++) {
                    std::cout << trajectories[0][i][j].item<float>();
                    if (j < trajectories.size(2) - 1) std::cout << ", ";
                }
                std::cout << "]" << std::endl;
            }
        }
        
        std::cout << "\n=== Test Complete ===" << std::endl;
        
    } catch (const std::exception& e) {
        std::cerr << "Error: " << e.what() << std::endl;
        return 1;
    }
    
    return 0;
}