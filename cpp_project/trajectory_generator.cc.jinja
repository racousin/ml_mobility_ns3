#include "trajectory_generator.h"
#include <iostream>
#include <stdexcept>

TrajectoryGenerator::TrajectoryGenerator(const std::string& model_path) 
    : device_(torch::kCPU), model_loaded_(false) {
    // Check for CUDA availability
    if (torch::cuda::is_available()) {
        std::cout << "CUDA is available! Using GPU." << std::endl;
        device_ = torch::kCUDA;
    } else {
        std::cout << "CUDA not available. Using CPU." << std::endl;
    }
    
    load_model(model_path);
}

void TrajectoryGenerator::load_model(const std::string& model_path) {
    try {
        // Load the TorchScript model
        model_ = torch::jit::load(model_path);
        model_.to(device_);
        model_.eval();
        
        model_loaded_ = true;
        std::cout << "Model loaded successfully from: " << model_path << std::endl;
        
    } catch (const c10::Error& e) {
        throw std::runtime_error("Error loading model: " + std::string(e.what()));
    }
}

torch::Tensor TrajectoryGenerator::generate(int batch_size, int sequence_length) {
    if (!model_loaded_) {
        throw std::runtime_error("Model not loaded!");
    }
    
    // Create random input tensor
    // Assuming input is [batch_size, sequence_length, features]
    int features = 2;  // Default to 2 features (x, y coordinates)
    torch::Tensor input = torch::randn({batch_size, sequence_length, features}, device_);
    
    return generate_from_input(input);
}

torch::Tensor TrajectoryGenerator::generate_from_input(torch::Tensor input) {
    if (!model_loaded_) {
        throw std::runtime_error("Model not loaded!");
    }
    
    // Move input to the correct device
    input = input.to(device_);
    
    // Disable gradient computation for inference
    torch::NoGradGuard no_grad;
    
    try {
        // Forward pass through the model
        std::vector<torch::jit::IValue> inputs;
        inputs.push_back(input);
        
        // Get output
        torch::Tensor output = model_.forward(inputs).toTensor();
        
        // Move output back to CPU for processing
        return output.to(torch::kCPU);
        
    } catch (const c10::Error& e) {
        throw std::runtime_error("Error during inference: " + std::string(e.what()));
    }
}