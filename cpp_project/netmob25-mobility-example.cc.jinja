#include "ns3/applications-module.h"
#include "ns3/core-module.h"
#include "ns3/internet-module.h"
#include "ns3/mobility-module.h"
#include "ns3/network-module.h"
#include "ns3/wifi-module.h"
#include "ns3/netanim-module.h"
#include "netmob25-mobility-model.h"

using namespace ns3;

NS_LOG_COMPONENT_DEFINE ("Netmob25MobilityExample");

/**
 * \brief Example of using Netmob25MobilityModel with WiFi network
 * 
 * This example demonstrates:
 * - Setting up nodes with Netmob25MobilityModel
 * - Creating WiFi ad-hoc network
 * - Running UDP echo applications
 * - Generating animation output for NetAnim
 * - Using ML-generated trajectories (experiment: {{ experiment_name }})
 */
int
main (int argc, char *argv[])
{
  // Command line parameters
  uint32_t nNodes = 4;
  double simTime = 30.0;
  bool useMLGeneration = false;
  std::string modelPath = "model.p";
  bool verbose = false;
  double printInterval = 5.0;
  bool enablePcap = false;
  std::string animationFile = "netmob25-animation.xml";
  
  CommandLine cmd (__FILE__);
  cmd.AddValue ("nNodes", "Number of nodes", nNodes);
  cmd.AddValue ("simTime", "Simulation time (seconds)", simTime);
  cmd.AddValue ("useMLGeneration", "Use ML model for trajectory generation", useMLGeneration);
  cmd.AddValue ("modelPath", "Path to ML model file", modelPath);
  cmd.AddValue ("verbose", "Enable verbose logging", verbose);
  cmd.AddValue ("printInterval", "Interval for printing positions (seconds)", printInterval);
  cmd.AddValue ("enablePcap", "Enable PCAP tracing", enablePcap);
  cmd.AddValue ("animationFile", "NetAnim output file", animationFile);
  cmd.Parse (argc, argv);

  if (verbose)
    {
      LogComponentEnable ("Netmob25MobilityModel", LOG_LEVEL_INFO);
      LogComponentEnable ("Netmob25MobilityExample", LOG_LEVEL_INFO);
    }

  // Create nodes
  NodeContainer nodes;
  nodes.Create (nNodes);

  // Setup WiFi
  WifiHelper wifi;
  wifi.SetStandard (WIFI_STANDARD_80211n);

  WifiMacHelper mac;
  mac.SetType ("ns3::AdhocWifiMac");

  YansWifiPhyHelper phy;
  YansWifiChannelHelper channel = YansWifiChannelHelper::Default ();
  phy.SetChannel (channel.Create ());

  NetDeviceContainer devices = wifi.Install (phy, mac, nodes);

  // Setup mobility
  MobilityHelper mobility;
  
  // Install Netmob25MobilityModel on all nodes
  mobility.SetMobilityModel ("ns3::Netmob25MobilityModel",
                            "StartTime", TimeValue (Seconds (0.0)),
                            "UpdateInterval", TimeValue (Seconds (1.0)),
                            "ScaleX", DoubleValue (1000.0),
                            "ScaleY", DoubleValue (1000.0),
                            "UseMLGeneration", BooleanValue (useMLGeneration),
                            "ModelPath", StringValue (modelPath));
  
  mobility.Install (nodes);

  // Create some simple trajectories for nodes if not using ML generation
  if (!useMLGeneration)
    {
      for (uint32_t i = 0; i < nNodes; ++i)
        {
          Ptr<Netmob25MobilityModel> mobilityModel = 
            nodes.Get (i)->GetObject<Netmob25MobilityModel> ();
          
          std::vector<Vector> trajectory;
          
          // Create different patterns for each node
          uint32_t numPoints = 60; // 60 seconds of movement
          double radius = 200.0 + i * 100.0; // Different radius per node
          double offset = i * M_PI / 2.0; // Phase offset
          
          for (uint32_t j = 0; j < numPoints; ++j)
            {
              double t = j * 2.0 * M_PI / numPoints;
              Vector pos;
              
              switch (i % 4)
                {
                case 0: // Circle
                  pos = Vector (radius * cos (t + offset), radius * sin (t + offset), 0.0);
                  break;
                case 1: // Figure-8
                  pos = Vector (radius * sin (2 * t + offset), radius * sin (t + offset), 0.0);
                  break;
                case 2: // Linear back and forth
                  pos = Vector (radius * sin (t + offset), i * 50.0, 0.0);
                  break;
                case 3: // Random walk
                default:
                  pos = Vector ((rand() % 200 - 100) + radius * cos (t + offset),
                               (rand() % 200 - 100) + radius * sin (t + offset), 0.0);
                  break;
                }
              
              trajectory.push_back (pos);
            }
          
          mobilityModel->SetTrajectory (trajectory);
        }
    }

  // Install Internet stack
  InternetStackHelper stack;
  stack.Install (nodes);

  // Assign IP addresses
  Ipv4AddressHelper address;
  address.SetBase ("10.1.1.0", "255.255.255.0");
  Ipv4InterfaceContainer interfaces = address.Assign (devices);

  // Setup applications (UDP echo)
  uint16_t port = 9;

  // Server on node 0
  UdpEchoServerHelper server (port);
  ApplicationContainer serverApp = server.Install (nodes.Get (0));
  serverApp.Start (Seconds (1.0));
  serverApp.Stop (Seconds (simTime));

  // Clients on other nodes
  for (uint32_t i = 1; i < nNodes; ++i)
    {
      UdpEchoClientHelper client (interfaces.GetAddress (0), port);
      client.SetAttribute ("MaxPackets", UintegerValue (100));
      client.SetAttribute ("Interval", TimeValue (Seconds (2.0)));
      client.SetAttribute ("PacketSize", UintegerValue (1024));

      ApplicationContainer clientApp = client.Install (nodes.Get (i));
      clientApp.Start (Seconds (2.0 + i * 0.5));
      clientApp.Stop (Seconds (simTime));
    }

  // Enable tracing if requested
  if (enablePcap)
    {
      phy.EnablePcapAll ("netmob25-pcap");
    }

  // Position printing callback
  auto printPositions = [&nodes, nNodes]() {
    std::cout << "Time: " << Simulator::Now ().GetSeconds () << "s - Node positions:" << std::endl;
    for (uint32_t i = 0; i < nNodes; ++i)
      {
        Ptr<MobilityModel> mobility = nodes.Get (i)->GetObject<MobilityModel> ();
        Vector pos = mobility->GetPosition ();
        std::cout << "  Node " << i << ": (" << pos.x << ", " << pos.y << ")" << std::endl;
      }
    std::cout << std::endl;
  };

  // Schedule position printing
  for (double t = printInterval; t < simTime; t += printInterval)
    {
      Simulator::Schedule (Seconds (t), printPositions);
    }

  // Enable NetAnim animation
  AnimationInterface anim (animationFile);
  
  // Set node descriptions for animation
  for (uint32_t i = 0; i < nNodes; ++i)
    {
      anim.UpdateNodeDescription (nodes.Get (i), "Node-" + std::to_string (i));
      anim.UpdateNodeColor (nodes.Get (i), 0, 255, 0); // Green nodes
    }
  
  // Set background image bounds (adjust as needed)
  anim.SetMaxPktsPerTraceFile (500000);

  std::cout << "=== Netmob25 Mobility Example ===" << std::endl;
  std::cout << "Nodes: " << nNodes << std::endl;
  std::cout << "Simulation time: " << simTime << " seconds" << std::endl;
  std::cout << "ML Generation: " << (useMLGeneration ? "Enabled" : "Disabled") << std::endl;
  if (useMLGeneration)
    {
      std::cout << "Model path: " << modelPath << std::endl;
    }
  std::cout << "Animation file: " << animationFile << std::endl;
  std::cout << "Experiment: {{ experiment_name }}" << std::endl;
  std::cout << "==============================" << std::endl;

  // Run simulation
  Simulator::Stop (Seconds (simTime));
  Simulator::Run ();
  Simulator::Destroy ();

  std::cout << "Simulation completed!" << std::endl;
  std::cout << "Generated animation: " << animationFile << std::endl;
  
  return 0;
}