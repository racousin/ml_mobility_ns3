#ifndef TRAJECTORY_GENERATOR_H
#define TRAJECTORY_GENERATOR_H

#include <torch/torch.h>
#include <torch/script.h>
#include <string>
#include <vector>
#include <memory>

class TrajectoryGenerator {
public:
    explicit TrajectoryGenerator(const std::string& model_path);
    ~TrajectoryGenerator() = default;
    
    // Generate trajectories
    // Returns tensor of shape [batch_size, sequence_length, features]
    torch::Tensor generate(int batch_size, int sequence_length);
    
    // Generate with custom input
    torch::Tensor generate_from_input(torch::Tensor input);
    
private:
    torch::jit::script::Module model_;
    torch::Device device_;
    bool model_loaded_;
    
    void load_model(const std::string& model_path);
};

#endif // TRAJECTORY_GENERATOR_H